{
  "name": "nekusora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle.pg.config.ts",
    "db:push:sqlite": "drizzle-kit push --config=drizzle.sqlite.config.ts",
    "db:studio:pg": "drizzle-kit studio --config=drizzle.pg.config.ts",
    "auth:generate": "better-auth-cli generate --config=src/auth.ts",
    "auth:migrate": "better-auth-cli migrate --config=src/auth.ts",
    "seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "worker": "tsx --env-file-if-exists=.env.local src/worker.ts",
    "postinstall": "node scripts/sync-pdfjs-assets.cjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/openai": "^4.0.7",
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@keyv/redis": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-virtual": "^3.14.5",
    "ai": "^7.0.15",
    "better-auth": "^1.2.0",
    "better-sqlite3": "^11.7.0",
    "cache-manager": "^6.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.39.0",
    "keyv": "^5.3.0",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.15.0",
    "nanoid": "^5.0.0",
    "next": "^15.1.0",
    "next-intl": "^4.13.0",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.13.0",
    "pg-boss": "^11.0.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.35.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "lightningcss"
    ],
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux",
        "win32"
      ],
      "cpu": [
        "arm64",
        "x64"
      ]
    }
  }
}
