# Nekusora Worker 多阶段构建。
FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/gateway/package.json ./apps/gateway/
COPY apps/web/package.json ./apps/web/
COPY apps/web/scripts/sync-pdfjs-assets.cjs ./apps/web/scripts/
COPY apps/worker/package.json ./apps/worker/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/core/package.json ./packages/core/
COPY packages/db/package.json ./packages/db/
COPY packages/observability/package.json ./packages/observability/
COPY packages/queue/package.json ./packages/queue/
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build:worker && pnpm --filter @nekusora/worker deploy --prod --legacy /prod/worker

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV DRIZZLE_MIGRATIONS_DIR=/app/drizzle/pg
ENV LOCAL_STORAGE_DIR=/app/uploads

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker

COPY --from=builder --chown=worker:nodejs /prod/worker ./
COPY --from=builder --chown=worker:nodejs /app/drizzle ./drizzle

RUN mkdir -p /app/uploads && chown -R worker:nodejs /app/uploads
VOLUME ["/app/uploads"]

USER worker
EXPOSE 4001
CMD ["node", "dist/main.js"]
