# drizzle
/drizzle/pg/meta
/drizzle/sqlite/meta
# 迁移基线重建时的本地备份(安全网,确认无误后可删)
/drizzle/*.backup.*

# typescript
*.tsbuildinfo

# editor
.vscode/*
!.vscode/extensions.json
.idea

# trellis developer identity (gitignored by convention)
.trellis/.developer

