!.env.example

# local data (SQLite fallback db, file uploads)
docs/cankao/
/data
/uploads

# pdfjs 第三方产物(cmaps + standard_fonts),由 postinstall 从 pdfjs-dist 同步
/public/pdfjs/cmaps
