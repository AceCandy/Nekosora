# Nekusora Gateway multi-stage production image.
FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/gateway/package.json ./apps/gateway/
COPY apps/web/package.json ./apps/web/
COPY apps/web/scripts/sync-pdfjs-assets.cjs ./apps/web/scripts/
COPY apps/worker/package.json ./apps/worker/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/core/package.json ./packages/core/
COPY packages/db/package.json ./packages/db/
COPY packages/observability/package.json ./packages/observability/
COPY packages/queue/package.json ./packages/queue/
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build:gateway && pnpm --filter @nekusora/gateway deploy --prod --legacy /prod/gateway

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV DRIZZLE_MIGRATIONS_DIR=/app/drizzle/pg
ENV LOCAL_STORAGE_DIR=/app/uploads
ENV GATEWAY_HOST=0.0.0.0
ENV GATEWAY_PORT=4000

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 gateway

COPY --from=builder --chown=gateway:nodejs /prod/gateway ./
COPY --from=builder --chown=gateway:nodejs /app/drizzle ./drizzle

RUN mkdir -p /app/uploads && chown -R gateway:nodejs /app/uploads
VOLUME ["/app/uploads"]

USER gateway
EXPOSE 4000
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:4000/healthz/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
