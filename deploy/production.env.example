# Copy to a private file outside version control and replace every placeholder.
APP_PORT=3000
IMAGE_TAG=local

POSTGRES_USER=nekusora
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=nekusora
DATABASE_URL=postgresql://nekusora:replace-with-a-url-encoded-password@postgres:5432/nekusora
REDIS_URL=redis://redis:6379

DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=https://example.com
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-password
SEED_ADMIN_NAME=Administrator

WEB_DB_POOL_MAX=5
GATEWAY_DB_POOL_MAX=10
WORKER_DB_POOL_MAX=5

STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

METRICS_ENABLED=true
# The scraper source range as seen by edge-router. The secure default is loopback only.
METRICS_ALLOW_CIDR=127.0.0.1/32
