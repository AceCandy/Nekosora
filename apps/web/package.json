{
  "name": "@nekusora/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core-pg": "tsx --env-file-if-exists=../../.env.local scripts/test-file-processing-lease-pg.ts",
    "test:api-key-pg": "tsx --env-file-if-exists=../../.env.local scripts/test-api-key-data-path-pg.ts",
    "check": "pnpm lint && pnpm typecheck",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle.pg.config.ts",
    "db:studio:pg": "drizzle-kit studio --config=drizzle.pg.config.ts",
    "auth:generate": "better-auth-cli generate --config=src/auth.ts",
    "auth:migrate": "better-auth-cli migrate --config=src/auth.ts",
    "seed": "tsx --env-file-if-exists=../../.env.local src/db/seed.ts",
    "postinstall": "node scripts/sync-pdfjs-assets.cjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "sync:pi-models": "tsx --env-file-if-exists=../../.env.local scripts/sync-pi-models.ts",
    "backfill:web-search-keys": "tsx --env-file-if-exists=../../.env.local scripts/backfill-web-search-keys.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@ai-sdk/xai": "4.0.16",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@keyv/redis": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nekusora/contracts": "workspace:*",
    "@nekusora/core": "workspace:*",
    "@nekusora/db": "workspace:*",
    "@nekusora/observability": "workspace:*",
    "@nekusora/queue": "workspace:*",
    "@shadcn/react": "^0.2.1",
    "@streamdown/code": "^1.1.1",
    "ai": "^7.0.31",
    "better-auth": "^1.6.23",
    "better-sqlite3": "12.11.1",
    "cache-manager": "^6.0.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "jsonrepair": "^3.15.0",
    "keyv": "^5.3.0",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.16.0",
    "nanoid": "^5.0.0",
    "next": "16.3.0",
    "next-intl": "^4.13.2",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.9.2",
    "sharp": "^0.35.3",
    "shiki": "3.23.0",
    "streamdown": "^2.5.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
